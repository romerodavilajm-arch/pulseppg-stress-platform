# Configuración del nodo PulsePPG. Copiar a /etc/pulseppg/pulseppg.env y ajustar.
# Tras cambiarla: sudo systemctl restart pulseppg

# Clave con la que el dispositivo está dado de alta en la tabla devices.
DEVICE_KEY=pi-lab-1
# IP del equipo donde corre docker compose (Mosquitto publica el 1883).
MQTT_HOST=192.168.1.50
MQTT_PORT=1883

# Sensor MAX30102 (bus I2C 1 = pines 3 y 5). Corriente de los LED: 0x24 ≈ 7 mA.
I2C_BUS=1
SENSOR_ADDRESS=0x57
LED_RED_PA=0x24
LED_IR_PA=0x24

# LCD 16x2 con adaptador PCF8574 (0x27 o 0x3F según el módulo). Vacío = sin LCD.
LCD_ADDRESS=0x27
# Buzzer activo, número de GPIO en numeración BCM. Vacío = sin buzzer.
BUZZER_PIN=18

# Captura y envío (docs/flujo.md §3). CAPTURE_SECONDS=300 son los 5 minutos;
# solo se baja para pruebas (el Analyzer necesita al menos 60 s).
CAPTURE_SECONDS=300
ACK_TIMEOUT=10
SEND_ATTEMPTS=3
RETRY_SECONDS=300
# Segundos que se muestra el código en el LCD antes de volver a reposo.
CODE_SECONDS=20

# Detección de dedo: valores provisionales, se calibran con check_sensor.py.
FINGER_IR_MIN=50000
FINGER_RATIO_MIN=0.5
FINGER_RATIO_MAX=3.0
FINGER_PI_MIN=0.0005
FINGER_PI_MAX=0.05
