# Copiar a .env y ajustar. Valores por defecto solo para desarrollo local.
POSTGRES_DB=pulseppg
POSTGRES_USER=pulseppg
POSTGRES_PASSWORD=pulseppg
POSTGRES_PORT=5432
MQTT_PORT=1883
ANALYZER_POLL_SECONDS=60
# Intentos del Analyzer antes de dar un análisis por fallido (la API lo usa también)
HRV_MAX_ATTEMPTS=3
# Umbrales de calidad del Analyzer HRV (provisionales, ver README)
HRV_SQI_MIN=0.86
HRV_PI_MIN=0.1
HRV_SNR_MIN_DB=0
# API/web
API_PORT=8000
# Zona horaria para mostrar fechas y filtrar por día en la administración
API_TIMEZONE=America/Mexico_City
